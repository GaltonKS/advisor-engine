# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Variables already set in your shell or on the host (Render) take precedence over this file.

# --- Market data ---------------------------------------------------------------
# synthetic (default, illustrative returns) | td (Twelve Data) | fmp (Financial Modeling Prep)
ADVISOR_MARKET_DATA=td
# Your vendor's API key. Secret: keep it here or in the host's settings, never in VITE_* vars.
TWELVE_DATA_API_KEY=
# FMP_API_KEY=
# Market index used for beta / market share of risk (default SPY)
# ADVISOR_MARKET_INDEX=SPY
# Price cache: supabase (default when SUPABASE_DB_URL is set) | disk | a directory
# ADVISOR_MARKET_CACHE=disk

# --- Galton AI (LLM) -------------------------------------------------------------
# Unset ADVISOR_LLM means: anthropic if ANTHROPIC_API_KEY is set, else the offline mock.
# ANTHROPIC_API_KEY=
# ADVISOR_LLM=mock
# ADVISOR_MODEL=claude-sonnet-5-5

# --- API (only needed for real sign-in / Supabase; leave unset for local dev auth) ---
# SUPABASE_URL=
# ADVISOR_AUTH=dev                 # supabase (default when SUPABASE_URL is set) | dev
# SUPABASE_JWT_SECRET=             # legacy HS256 projects only; empty means JWKS
# SUPABASE_DB_URL=
# SUPABASE_SECRET_KEY=
# ALLOWED_ORIGINS=http://localhost:5173
# ADVISOR_API_STORE=data/api
# ADVISOR_DAILY_TURN_LIMIT=200
# ADVISOR_OPERATORS=               # comma-separated operator emails
# ADVISOR_REQUIRE_MFA=off          # off | enrol | required
# ADVISOR_MFA_DEADLINE=            # e.g. 2026-11-15, shown during enrol
# RENDER is set by Render itself; don't set it locally.

# --- Development and tests ---------------------------------------------------------
# ADVISOR_NO_DOTENV=1              # skip this file entirely (the test suite sets it)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# The web app's VITE_* variables are in web/.env.example. Full list: README.md,
# "Environment variables".
