# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Variables already set in your shell or on the host (Render) take precedence over this file.

# --- Market data ---------------------------------------------------------------
# synthetic (default, illustrative returns) | fmp (Financial Modeling Prep)
ADVISOR_MARKET_DATA=fmp
# Your FMP API key. Secret: keep it here or in the host's settings, never in VITE_* vars.
FMP_API_KEY=
# Market index used for beta / market share of risk (default SPY)
# ADVISOR_MARKET_INDEX=SPY
# Price cache: supabase (default when SUPABASE_DB_URL is set) | disk | a directory
# ADVISOR_MARKET_CACHE=disk

# --- Galton AI (LLM) -------------------------------------------------------------
# Unset ADVISOR_LLM means: anthropic if ANTHROPIC_API_KEY is set, else the offline mock.
# ANTHROPIC_API_KEY=
# ADVISOR_LLM=mock
# ADVISOR_MODEL=claude-sonnet-5-5

# --- API (only needed for real sign-in / Supabase; leave unset for local dev auth) ---
# SUPABASE_URL=
# SUPABASE_DB_URL=
# SUPABASE_SECRET_KEY=
# ALLOWED_ORIGINS=http://localhost:5173
